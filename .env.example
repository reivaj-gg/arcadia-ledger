# ---------------------------------------------------------------------------
# Arcadia — local environment
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# ---------------------------------------------------------------------------

# Meta Model API key. Used by server/index.ts ONLY.
# It must never be prefixed with VITE_: Vite inlines every VITE_* variable
# into the client bundle, which would publish the key with the demo.
MODEL_API_KEY=

# true  -> the adapter returns deterministic fixtures and makes zero network calls.
# false -> real calls to the Meta Model API (requires MODEL_API_KEY).
# Omitted with no key present -> mock. Omitted with a key present -> live.
MOCK_MODE=true

# Optional overrides.
# META_BASE_URL=https://api.meta.ai/v1
# PORT=8787
# HOST=127.0.0.1
