{
  "name": "arcadia-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Arcadia — a verifiable spatial ledger. Every claim is anchored to a pixel mask or an audio turn.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --port 3000 --host",
    "dev:api": "node server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.ts\"",
    "eval": "node scripts/eval.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@meta-sam/parser": "^0.1.0",
    "@noble/hashes": "^2.4.0",
    "three": "^0.180.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  }
}
