{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Runtime: Node 24 strips types natively and Vite compiles for the browser.
       `noEmit` is mandatory here because `allowImportingTsExtensions` means the
       source is the artifact — tsc is a type checker, never a bundler. */
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,

    /* Node runs these files with type stripping, which only understands
       *erasable* syntax. `erasableSyntaxOnly` turns "works in tsc, explodes at
       runtime" into a compile error: no enums, no namespaces, no parameter
       properties, no `import =`. */
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "server/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
